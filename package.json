{
	"name": "tghclparser",
	"type": "module",
	"version": "1.136.951",
	"description": "Parser for .hcl files developed to be used as a vscode language server.",
	"author": {
		"name": "Bahram Shamshiri",
		"email": "jowharshamshiri@gmail.com"
	},
	"license": "MIT",
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/jowharshamshiri"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jowharshamshiri/tghclparser.git"
	},
	"keywords": [
		"vscode",
		"language-server",
		"parser",
		"hcl",
		"terraform",
		"terragrunt"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"tghclp": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --external vscode-languageserver-types --external vscode-languageserver",
		"format": "prettier --write \"src/**/*.ts\"",
		"lint": "eslint --fix",
		"parser": "peggy --cache --trace --format 'es' --dts --dependency \"{Schema}:./Schema.ts\" --output src/parser.js grammar.peggy",
		"prepare": "npm run build",
		"prepublishOnly": "npm test && npm run lint",
		"test": "tsx node_modules/.bin/mocha 'tests/**/*.test.ts'"
	},
	"peerDependencies": {
		"typescript": ">=4.7.0"
	},
	"dependencies": {
		"@aws-sdk/client-iam": "^3.x",
		"@aws-sdk/client-sts": "^3.x",
		"@aws-sdk/credential-providers": "^3.x",
		"@aws-sdk/types": "^3.x",
		"bcryptjs": "^3.0.3",
		"js-yaml": "^4.1.0",
		"pegjs-backtrace": "^0.2.1",
		"vscode-languageserver": "^10.1.0",
		"vscode-languageserver-types": "^3.17.5",
		"vscode-uri": "^3.1.0"
	},
	"devDependencies": {
		"@types/chai": "^5.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.4",
		"@types/vscode": "^1.97.0",
		"brace-expansion": "^1.1.18",
		"chai": "5.1.2",
		"@eslint/js": "^9.39.0",
		"eslint": "^9.39.0",
		"lint-staged": "^16.2.0",
		"mocha": "^11.7.0",
		"peggy": "^4.2.0",
		"prettier": "^3.3.3",
		"simple-git-hooks": "2.11.1",
		"tsup": "^8.5.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.46.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"prettier --ignore-path ./.gitignore --write "
		],
		"*.{js,ts,cjs,mjs}": [
			"eslint --fix"
		]
	},
	"overrides": {
		"mocha": {
			"diff": "8.0.3",
			"serialize-javascript": "7.0.5"
		},
		"tsup": {
			"esbuild": "0.28.1"
		}
	},
	"source": "./src/index.ts"
}
