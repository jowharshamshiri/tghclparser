{
	"name": "tghclparser",
	"type": "module",
	"version": "{{ project.version }}",
	"description": "A drop-in replacement for the terragrunt CLI, and the HCL parser and language server behind it. Runs OpenTofu/Terraform through Terragrunt configurations — includes, dependencies, generate blocks, stacks — and matches terragrunt's own behaviour, checked against it rather than against the documentation.",
	"author": {
		"name": "Bahram Shamshiri",
		"email": "jowharshamshiri@gmail.com"
	},
	"license": "MIT",
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/jowharshamshiri"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jowharshamshiri/tghclparser.git"
	},
	"homepage": "https://github.com/jowharshamshiri/tghclparser#readme",
	"bugs": {
		"url": "https://github.com/jowharshamshiri/tghclparser/issues"
	},
	"keywords": [
		"terragrunt",
		"terragrunt-alternative",
		"terragrunt-replacement",
		"drop-in-replacement",
		"opentofu",
		"terraform",
		"infrastructure-as-code",
		"iac",
		"hcl",
		"hcl2",
		"parser",
		"cli",
		"language-server",
		"lsp",
		"vscode"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"bin": {
		"tghclp": "dist/cli.mjs"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^22.18.0 || ^24.11.0 || >=26.0.0",
			"onFail": "error"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"format": "prettier --write \"src/**/*.ts\"",
		"lint": "eslint --fix",
		"lint:ci": "eslint",
		"parser": "peggy --cache --trace --format 'es' --dts --dependency \"{Schema}:./Schema.ts\" --dependency \"{scanJsBody}:./js-body.ts\" --output src/parser.js grammar.peggy",
		"prepare": "npm run build",
		"prepublishOnly": "npm test && npm run lint",
		"pretest": "npm run build",
		"test": "mocha",
		"test:package": "mocha --config tests/package/.mocharc.json",
		"tghclp": "tsx src/cli.ts",
		"typecheck": "tsc"
	},
	"peerDependencies": {
		"typescript": ">=4.7.0"
	},
	"dependencies": {
		"@aws-sdk/client-iam": "^3.x",
		"@aws-sdk/client-sts": "^3.x",
		"@aws-sdk/credential-providers": "^3.x",
		"@aws-sdk/types": "^3.x",
		"@jowharshamshiri/ops-ts": "1.4.49",
		"bcryptjs": "^3.0.3",
		"js-yaml": "^4.1.0",
		"pegjs-backtrace": "^0.2.1",
		"tar-stream": "^3.2.1",
		"vscode-languageserver": "^10.1.0",
		"vscode-languageserver-types": "^3.17.5",
		"vscode-uri": "^3.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.2",
		"@types/chai": "^5.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.4",
		"@types/vscode": "^1.97.0",
		"brace-expansion": "^1.1.18",
		"chai": "5.1.2",
		"eslint": "^9.39.0",
		"eslint-formatter-gha": "2.0.1",
		"globals": "^17.12.0",
		"lint-staged": "^16.2.0",
		"mocha": "^12.0.1",
		"peggy": "^4.2.0",
		"prettier": "^3.3.3",
		"publint": "^0.3.25",
		"simple-git-hooks": "2.11.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.46.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"prettier --ignore-path ./.gitignore --write "
		],
		"*.{js,ts,cjs,mjs}": [
			"eslint --fix"
		]
	},
	"overrides": {
		"mocha": {
			"diff": "8.0.3",
			"serialize-javascript": "7.0.5"
		}
	},
	"source": "./src/index.ts"
}
